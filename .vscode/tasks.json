{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "VisualEditor: Bundle (Debug)",
			"type": "shell",
			"command": "esbuild src/main.js --bundle --outfile=build/bundle.js --format=iife --keep-names --sourcemap",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "VisualEditor: Bundle (Release)",
			"type": "shell",
			"command": "esbuild src/main.js --bundle --outfile=build/bundle.min.js --format=iife --minify",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}